# Caddy = терминация TLS + автоматический Let's Encrypt.
# Подставьте свой домен. Нужно: DNS домена → IP VPS, открытые порты 80 и 443.
iprahelp.ru, www.iprahelp.ru {
    encode gzip
    # HSTS — браузер запоминает, что сайт только по HTTPS
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # Проксируем на внутренний nginx (сервис web), наружу nginx не публикуется
    reverse_proxy web:80
}
