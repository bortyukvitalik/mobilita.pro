# ── Скопируйте в .env и подставьте свои значения ──
# Файл .env в репозиторий НЕ коммитится (см. .gitignore)

# PostgreSQL
POSTGRES_USER=iprahelp
POSTGRES_PASSWORD=ЗАМЕНИТЕ_на_надёжный_пароль
POSTGRES_DB=iprahelp

# Бекенд
# Токен для выгрузки заявок (заголовок X-Admin-Token). Сгенерируйте длинный случайный:
#   openssl rand -hex 32
ADMIN_TOKEN=ЗАМЕНИТЕ_на_длинный_случайный_токен

# Домены сайта (через запятую). Сайт ходит на тот же домен — в норме менять не нужно.
ALLOWED_ORIGINS=https://iprahelp.ru,https://www.iprahelp.ru

# Лимит заявок с одного IP (плюс глобальный потолок 120/мин в коде)
RATE_LIMIT=1/second

# Счётчик «обратились сегодня»: simulated (имитация по времени) | real (из таблицы leads)
STATS_MODE=simulated

# База для счётчика «семей получили ТСР» (показывается как STATS_BASELINE + число заявок)
STATS_BASELINE=1000

# Swagger /docs: true только для локальной отладки, на проде — false
DOCS_ENABLED=false

# Порт, на котором сайт слушает на хосте. Для прода — 80.
# Локально поставьте свободный (напр. 8090), если 80 занят другим проектом.
WEB_PORT=80

# ── Доставка лидов в CRM (сервис crm-worker: очередь + ретраи 15м→1ч→6ч) ──
# off    — выключено (лиды копятся в статусе new);
# stub   — тест: имитация успешной отправки;  stub_fail — тест: всегда ошибка;
# bitrix — реальная отправка в Bitrix24 (нужен CRM_WEBHOOK_URL).
CRM_MODE=off
# Входящий вебхук Bitrix24. СЕКРЕТ — реальное значение только в .env, сюда НЕ вписывать.
#   https://ВАШ-ПОРТАЛ.bitrix24.ru/rest/1/ВАШ_ТОКЕН/
CRM_WEBHOOK_URL=
CRM_BATCH_SIZE=50
# Поля лида в Bitrix24 (crm.lead.add)
CRM_STATUS_ID=UC_RYNCPM
CRM_SOURCE_ID=UC_IPRA_PROJECT
CRM_SOURCE_DESCRIPTION=Отдельный лендинг
CRM_TITLE_PREFIX=Лендинг Эрготерапевт

# ── Легаси: FTP-деплой статики на shared-хостинг reg.ru (если ещё используется) ──
# Пароль сюда НЕ вписывайте в примере — только в реальный .env
FTP_HOST=server295.hosting.reg.ru
FTP_USER=u3527767
FTP_PASS=
FTP_REMOTE=/www/iprahelp.ru
